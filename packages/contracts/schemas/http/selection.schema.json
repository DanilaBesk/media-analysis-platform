{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://media-analysis.local/contracts/schemas/http/selection.schema.json",
  "title": "SelectionContracts",
  "$defs": {
    "selectionItemLabels": {
      "type": "object",
      "required": [
        "display_label"
      ],
      "properties": {
        "display_label": {
          "type": "string",
          "minLength": 1
        },
        "source_label": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "original_filename": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "selectionItemSnapshot": {
      "type": "object",
      "required": [
        "selection_item_id",
        "position",
        "media_item_id",
        "kind",
        "media_kind",
        "mime_type",
        "role",
        "labels",
        "source_snapshot",
        "display_name",
        "status_at_selection",
        "retention_snapshot"
      ],
      "properties": {
        "selection_item_id": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "media_item_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "kind": {
          "$ref": "../common/enums.schema.json#/$defs/mediaKind"
        },
        "media_kind": {
          "$ref": "../common/enums.schema.json#/$defs/mediaKind"
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "default": "primary"
        },
        "labels": {
          "$ref": "#/$defs/selectionItemLabels"
        },
        "source_snapshot": {
          "$ref": "./media-item.schema.json#/$defs/sourceMetadata"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "status_at_selection": {
          "$ref": "../common/enums.schema.json#/$defs/mediaItemStatus"
        },
        "metadata_snapshot": {
          "type": "object"
        },
        "retention_snapshot": {
          "$ref": "../common/pagination.schema.json#/$defs/retentionMetadata"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "./diagnostic.schema.json#/$defs/diagnosticSummary"
          }
        }
      },
      "additionalProperties": false
    },
    "createSelectionRequest": {
      "type": "object",
      "required": [
        "owner",
        "items"
      ],
      "properties": {
        "owner": {
          "$ref": "../common/owner-scope.schema.json#/$defs/ownerScope"
        },
        "source_collection_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "media_item_id",
              "position"
            ],
            "properties": {
              "media_item_id": {
                "$ref": "../common/enums.schema.json#/$defs/uuid"
              },
              "position": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "option_snapshot": {
          "type": "object"
        },
        "duplicate_policy": {
          "type": "string",
          "enum": [
            "reject",
            "allow"
          ],
          "default": "reject"
        },
        "created_by": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "required": [
        "selection_id",
        "owner",
        "status",
        "items",
        "option_snapshot",
        "created_by",
        "created_at",
        "sealed_at"
      ],
      "properties": {
        "selection_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "owner": {
          "$ref": "../common/owner-scope.schema.json#/$defs/ownerScope"
        },
        "status": {
          "$ref": "../common/enums.schema.json#/$defs/selectionStatus"
        },
        "source_collection_id": {
          "oneOf": [
            {
              "$ref": "../common/enums.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/selectionItemSnapshot"
          }
        },
        "option_snapshot": {
          "type": "object"
        },
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "./diagnostic.schema.json#/$defs/diagnosticSummary"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "sealed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "selectionResponse": {
      "type": "object",
      "required": [
        "selection"
      ],
      "properties": {
        "selection": {
          "$ref": "#/$defs/selection"
        }
      },
      "additionalProperties": false
    }
  }
}
