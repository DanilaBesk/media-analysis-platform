{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://media-analysis.local/contracts/schemas/http/collection.schema.json",
  "title": "CollectionContracts",
  "$defs": {
    "collectionItem": {
      "type": "object",
      "required": [
        "media_asset_id",
        "position",
        "added_at"
      ],
      "properties": {
        "media_asset_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "media_asset": {
          "$ref": "./media-asset.schema.json#/$defs/mediaAsset"
        },
        "added_by": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "added_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "collection": {
      "type": "object",
      "required": [
        "collection_id",
        "channel_account_id",
        "kind",
        "name",
        "status",
        "version",
        "items",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "collection_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "channel_account_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "kind": {
          "$ref": "../common/enums.schema.json#/$defs/collectionKind"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "../common/enums.schema.json#/$defs/collectionStatus"
        },
        "version": {
          "$ref": "../common/pagination.schema.json#/$defs/optimisticVersion"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/collectionItem"
          }
        },
        "page": {
          "$ref": "../common/pagination.schema.json#/$defs/page"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "archived_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "deleted_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "createCollectionRequest": {
      "type": "object",
      "required": [
        "channel_account_id",
        "name"
      ],
      "properties": {
        "channel_account_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "../common/enums.schema.json#/$defs/uuid"
          }
        }
      },
      "additionalProperties": false
    },
    "updateCollectionRequest": {
      "type": "object",
      "required": [
        "channel_account_id",
        "expected_version"
      ],
      "properties": {
        "channel_account_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "expected_version": {
          "$ref": "../common/pagination.schema.json#/$defs/optimisticVersion"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "../common/enums.schema.json#/$defs/collectionStatus"
        }
      },
      "additionalProperties": false
    },
    "updateCollectionItemsRequest": {
      "type": "object",
      "required": [
        "channel_account_id",
        "expected_version",
        "items"
      ],
      "properties": {
        "channel_account_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "expected_version": {
          "$ref": "../common/pagination.schema.json#/$defs/optimisticVersion"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "media_asset_id",
              "position"
            ],
            "properties": {
              "media_asset_id": {
                "$ref": "../common/enums.schema.json#/$defs/uuid"
              },
              "position": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "createProcessingRunRequest": {
      "type": "object",
      "required": [
        "channel_account_id",
        "expected_version",
        "run_type",
        "selected_item_ids"
      ],
      "properties": {
        "channel_account_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "expected_version": {
          "$ref": "../common/pagination.schema.json#/$defs/optimisticVersion"
        },
        "run_type": {
          "type": "string",
          "enum": ["transcription", "report", "deep_research"]
        },
        "selected_item_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "../common/enums.schema.json#/$defs/uuid"
          }
        },
        "options": {
          "type": "object"
        },
        "created_via_channel_account_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        }
      },
      "additionalProperties": false
    },
    "analysisRunStepLaunch": {
      "type": "object",
      "required": [
        "analysis_run_step_id",
        "analysis_run_id",
        "step_kind",
        "worker_kind",
        "status",
        "attempt_no"
      ],
      "properties": {
        "analysis_run_step_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "analysis_run_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "step_kind": {
          "type": "string",
          "minLength": 1
        },
        "worker_kind": {
          "$ref": "../common/enums.schema.json#/$defs/workerKind"
        },
        "status": {
          "$ref": "../common/enums.schema.json#/$defs/analysisRunStepStatus"
        },
        "attempt_no": {
          "type": "integer",
          "minimum": 0
        },
        "claimed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "heartbeat_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "finalized_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "analysisRunLaunch": {
      "type": "object",
      "required": [
        "analysis_run_id",
        "channel_account_id",
        "selection_snapshot_id",
        "run_type",
        "status",
        "version",
        "params",
        "delivery",
        "evidence_gate_state",
        "analysis_run_steps",
        "created_at"
      ],
      "properties": {
        "analysis_run_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "channel_account_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "selection_snapshot_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "run_type": {
          "$ref": "../common/enums.schema.json#/$defs/runType"
        },
        "status": {
          "$ref": "../common/enums.schema.json#/$defs/analysisRunStatus"
        },
        "version": {
          "$ref": "../common/pagination.schema.json#/$defs/optimisticVersion"
        },
        "params": {
          "type": "object"
        },
        "delivery": {
          "$ref": "./analysis-run.schema.json#/$defs/deliveryPreference"
        },
        "evidence_gate_state": {
          "type": "string",
          "enum": ["not_required", "waiting", "passed", "failed"]
        },
        "analysis_run_steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/analysisRunStepLaunch"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "./artifact.schema.json#/$defs/artifactSummary"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "./diagnostic.schema.json#/$defs/diagnosticSummary"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "started_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "completed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "cancel_requested_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "canceled_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "expires_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "processingRunResponse": {
      "type": "object",
      "required": [
        "selection_snapshot",
        "analysis_run",
        "detached_media_asset_ids",
        "collection_version"
      ],
      "properties": {
        "analysis_run": {
          "$ref": "#/$defs/analysisRunLaunch"
        },
        "selection_snapshot": {
          "$ref": "./selection-snapshot.schema.json#/$defs/selectionSnapshot"
        },
        "detached_media_asset_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "../common/enums.schema.json#/$defs/uuid"
          }
        },
        "collection_version": {
          "$ref": "../common/pagination.schema.json#/$defs/optimisticVersion"
        }
      },
      "additionalProperties": false
    },
    "collectionResponse": {
      "type": "object",
      "required": [
        "collection"
      ],
      "properties": {
        "collection": {
          "$ref": "#/$defs/collection"
        }
      },
      "additionalProperties": false
    },
    "collectionListResponse": {
      "allOf": [
        {
          "$ref": "../common/pagination.schema.json#/$defs/paginatedResponse"
        },
        {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/collection"
              }
            }
          }
        }
      ]
    }
  }
}
