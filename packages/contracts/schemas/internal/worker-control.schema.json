{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://media-analysis.local/contracts/schemas/internal/worker-control.schema.json",
  "title": "InternalAnalysisWorkerControl",
  "$defs": {
    "claimStepRequest": {
      "type": "object",
      "required": [
        "worker_kind",
        "step_kind"
      ],
      "properties": {
        "worker_kind": {
          "$ref": "../common/enums.schema.json#/$defs/workerKind"
        },
        "step_kind": {
          "type": "string",
          "minLength": 1
        },
        "lease_owner": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "selectionSnapshotInput": {
      "type": "object",
      "required": [
        "selection_snapshot_id",
        "items",
        "option_snapshot",
        "sealed_at"
      ],
      "properties": {
        "selection_snapshot_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../http/selection-snapshot.schema.json#/$defs/selectionSnapshotItem"
          }
        },
        "option_snapshot": {
          "type": "object"
        },
        "sealed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "claimStepResponse": {
      "type": "object",
      "required": [
        "analysis_run_step_id",
        "analysis_run_id",
        "run_type",
        "selection_snapshot",
        "analysis_run_step_inputs",
        "params",
        "claimed_at"
      ],
      "properties": {
        "analysis_run_step_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "analysis_run_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "run_type": {
          "$ref": "../common/enums.schema.json#/$defs/runType"
        },
        "selection_snapshot": {
          "$ref": "#/$defs/selectionSnapshotInput"
        },
        "analysis_run_step_inputs": {
          "type": "array",
          "items": {
            "$ref": "../http/analysis-run.schema.json#/$defs/analysisRunStepInput"
          }
        },
        "params": {
          "type": "object"
        },
        "claimed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "claimRequest": {
      "type": "object",
      "required": [
        "worker_kind",
        "task_type"
      ],
      "properties": {
        "worker_kind": {
          "$ref": "../common/enums.schema.json#/$defs/workerKind"
        },
        "task_type": {
          "$ref": "../common/enums.schema.json#/$defs/taskType"
        },
        "lease_owner": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "analysisRunQueueItem": {
      "type": "object",
      "required": [
        "analysis_run_step_id",
        "analysis_run_id",
        "run_type",
        "worker_kind",
        "step_kind",
        "status",
        "version",
        "attempt_no",
        "created_at"
      ],
      "properties": {
        "analysis_run_step_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "analysis_run_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "run_type": {
          "$ref": "../common/enums.schema.json#/$defs/runType"
        },
        "worker_kind": {
          "$ref": "../common/enums.schema.json#/$defs/workerKind"
        },
        "step_kind": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "pending_enqueue",
            "queued",
            "running",
            "claimed",
            "succeeded",
            "partially_succeeded",
            "failed",
            "canceled"
          ]
        },
        "version": {
          "$ref": "../common/enums.schema.json#/$defs/optimisticVersion"
        },
        "attempt_no": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "analysisRunQueueResponse": {
      "type": "object",
      "required": [
        "items",
        "page",
        "page_size"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/analysisRunQueueItem"
          }
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "page_size": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "sealedSelectionInput": {
      "type": "object",
      "required": [
        "selection_id",
        "items",
        "option_snapshot",
        "sealed_at"
      ],
      "properties": {
        "selection_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../http/selection.schema.json#/$defs/selectionItemSnapshot"
          }
        },
        "option_snapshot": {
          "type": "object"
        },
        "sealed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "claimResponse": {
      "type": "object",
      "required": [
        "execution_id",
        "analysis_run_id",
        "run_type",
        "selection",
        "params",
        "claimed_at"
      ],
      "properties": {
        "execution_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "analysis_run_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "run_type": {
          "$ref": "../common/enums.schema.json#/$defs/runType"
        },
        "selection": {
          "$ref": "#/$defs/sealedSelectionInput"
        },
        "params": {
          "type": "object"
        },
        "claimed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "requestAccessResponse": {
      "type": "object",
      "required": [
        "provider",
        "url",
        "expires_at",
        "request_ref",
        "request_digest_sha256",
        "request_bytes"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "minio_presigned_url"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "request_ref": {
          "type": "string",
          "minLength": 1
        },
        "request_digest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "request_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "cancelCheckResponse": {
      "type": "object",
      "required": [
        "cancel_requested",
        "status"
      ],
      "properties": {
        "cancel_requested": {
          "type": "boolean"
        },
        "status": {
          "$ref": "../common/enums.schema.json#/$defs/analysisRunStatus"
        },
        "cancel_requested_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "artifactDownloadAccessResponse": {
      "type": "object",
      "required": [
        "artifact_id",
        "analysis_run_id",
        "artifact_kind",
        "filename",
        "mime_type",
        "size_bytes",
        "created_at",
        "download"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "analysis_run_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "artifact_kind": {
          "$ref": "#/$defs/workerArtifactDescriptorKind"
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "mime_type": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "download": {
          "type": "object",
          "required": [
            "provider",
            "url",
            "expires_at"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "progressRequest": {
      "type": "object",
      "required": [
        "analysis_run_step_id",
        "progress_stage"
      ],
      "properties": {
        "analysis_run_step_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "progress_stage": {
          "type": "string",
          "minLength": 1
        },
        "progress_message": {
          "type": [
            "string",
            "null"
          ]
        },
        "item_position": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "workerArtifactDescriptorKind": {
      "type": "string",
      "enum": [
        "transcript_plain",
        "transcript_segmented_markdown",
        "transcript_docx",
        "summary_markdown",
        "report_markdown",
        "report_docx",
        "deep_research_markdown",
        "agent_result_json",
        "execution_log",
        "run_manifest",
        "run_diagnostics"
      ]
    },
    "artifactDescriptor": {
      "type": "object",
      "required": [
        "artifact_kind",
        "filename",
        "mime_type",
        "object_key",
        "size_bytes"
      ],
      "properties": {
        "artifact_kind": {
          "$ref": "#/$defs/workerArtifactDescriptorKind"
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "mime_type": {
          "type": "string",
          "minLength": 1
        },
        "object_key": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "format": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "artifactUpsertRequest": {
      "type": "object",
      "required": [
        "analysis_run_step_id",
        "artifacts"
      ],
      "properties": {
        "analysis_run_step_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifactDescriptor"
          }
        }
      },
      "additionalProperties": false
    },
    "diagnosticDescriptor": {
      "type": "object",
      "required": [
        "diagnostic_id",
        "subject_type",
        "subject_id",
        "severity",
        "code",
        "message",
        "created_at"
      ],
      "properties": {
        "diagnostic_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_type": {
          "$ref": "../common/enums.schema.json#/$defs/diagnosticSubjectType"
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "$ref": "../common/enums.schema.json#/$defs/diagnosticSeverity"
        },
        "code": {
          "$ref": "../common/enums.schema.json#/$defs/diagnosticCode"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "object"
        },
        "safe_adapter_context": {
          "type": "object"
        },
        "correlation_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "remediation_hint": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "diagnosticUpsertRequest": {
      "type": "object",
      "required": [
        "analysis_run_step_id",
        "diagnostics"
      ],
      "properties": {
        "analysis_run_step_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/diagnosticDescriptor"
          }
        }
      },
      "additionalProperties": false
    },
    "finalizeRequest": {
      "type": "object",
      "required": [
        "analysis_run_step_id",
        "outcome"
      ],
      "properties": {
        "analysis_run_step_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "outcome": {
          "$ref": "../common/enums.schema.json#/$defs/workerOutcome"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "legacyExecutionProgressRequest": {
      "type": "object",
      "required": [
        "execution_id",
        "progress_stage"
      ],
      "properties": {
        "execution_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "progress_stage": {
          "type": "string",
          "minLength": 1
        },
        "progress_message": {
          "type": [
            "string",
            "null"
          ]
        },
        "item_position": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "legacyExecutionFinalizeRequest": {
      "type": "object",
      "required": [
        "execution_id",
        "outcome"
      ],
      "properties": {
        "execution_id": {
          "$ref": "../common/enums.schema.json#/$defs/uuid"
        },
        "outcome": {
          "$ref": "../common/enums.schema.json#/$defs/workerOutcome"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
