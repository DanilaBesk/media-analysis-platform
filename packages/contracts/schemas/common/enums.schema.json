{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://media-analysis.local/contracts/schemas/common/enums.schema.json",
  "title": "Shared inbox-first enum surface",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "ownerType": {
      "deprecated": true,
      "type": "string",
      "enum": [
        "user",
        "telegram",
        "web",
        "mcp",
        "service"
      ]
    },
    "mediaKind": {
      "type": "string",
      "enum": [
        "text",
        "url",
        "file",
        "photo",
        "image",
        "audio",
        "voice",
        "video",
        "document"
      ]
    },
    "sourceOriginType": {
      "deprecated": true,
      "type": "string",
      "enum": [
        "text",
        "url",
        "object"
      ]
    },
    "mediaItemStatus": {
      "deprecated": true,
      "type": "string",
      "enum": [
        "validating",
        "ready",
        "quarantined",
        "deleted"
      ]
    },
    "mediaAssetStatus": {
      "type": "string",
      "enum": [
        "ingesting",
        "available",
        "invalid",
        "quarantined",
        "deleted"
      ]
    },
    "storedObjectStatus": {
      "type": "string",
      "enum": [
        "pending",
        "available",
        "missing",
        "deleted"
      ]
    },
    "collectionKind": {
      "type": "string",
      "enum": [
        "inbox",
        "user"
      ]
    },
    "collectionStatus": {
      "type": "string",
      "enum": [
        "active",
        "archived",
        "deleted"
      ]
    },
    "selectionStatus": {
      "deprecated": true,
      "type": "string",
      "enum": [
        "sealed",
        "invalidated"
      ]
    },
    "selectionSnapshotStatus": {
      "type": "string",
      "enum": [
        "sealed",
        "invalidated"
      ]
    },
    "analysisRunStatus": {
      "type": "string",
      "enum": [
        "queued",
        "claiming",
        "running",
        "cancel_requested",
        "partially_succeeded",
        "succeeded",
        "failed",
        "canceled",
        "expired"
      ]
    },
    "analysisRunStepStatus": {
      "type": "string",
      "enum": [
        "pending",
        "queued",
        "claimed",
        "succeeded",
        "partially_succeeded",
        "failed",
        "canceled"
      ]
    },
    "runType": {
      "type": "string",
      "enum": [
        "transcription",
        "summary",
        "report",
        "deep_research",
        "custom"
      ]
    },
    "deliveryStrategy": {
      "type": "string",
      "enum": [
        "polling",
        "webhook"
      ]
    },
    "runEventType": {
      "type": "string",
      "enum": [
        "analysis_run.created",
        "analysis_run.started",
        "analysis_run.progress",
        "analysis_run.cancel_requested",
        "analysis_run.completed",
        "analysis_run.failed",
        "analysis_run.canceled",
        "artifact.created",
        "diagnostic.recorded"
      ]
    },
    "artifactKind": {
      "type": "string",
      "enum": [
        "transcript",
        "summary",
        "report",
        "deep_research",
        "structured_data",
        "source_manifest",
        "run_manifest",
        "execution_log",
        "diagnostic_bundle",
        "run_diagnostics",
        "preview"
      ]
    },
    "artifactStatus": {
      "type": "string",
      "enum": [
        "pending",
        "available",
        "failed",
        "expired",
        "deleted"
      ]
    },
    "artifactVisibility": {
      "type": "string",
      "enum": [
        "private",
        "channel_deliverable"
      ]
    },
    "diagnosticSeverity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error"
      ]
    },
    "diagnosticSubjectType": {
      "type": "string",
      "enum": [
        "media_asset",
        "stored_object",
        "collection",
        "selection_snapshot",
        "selection_snapshot_item",
        "analysis_run",
        "analysis_run_step",
        "artifact",
        "artifact_subject",
        "diagnostic",
        "channel_account",
        "channel_surface",
        "operation_request",
        "media_item",
        "source",
        "selection",
        "adapter",
        "retention"
      ]
    },
    "diagnosticCode": {
      "type": "string",
      "enum": [
        "media_asset_invalid",
        "channel_account_mismatch",
        "selection_snapshot_invalid",
        "selection_snapshot_not_sealed",
        "stored_object_unavailable",
        "analysis_prerequisite_missing",
        "analysis_prerequisite_failed",
        "analysis_prerequisite_unavailable",
        "media_item_invalid",
        "owner_mismatch",
        "collection_version_conflict",
        "selection_invalid",
        "selection_not_sealed",
        "source_unavailable",
        "worker_failed",
        "artifact_unavailable",
        "artifact_resolution_failed",
        "orphan_object_cleanup",
        "orphan_object_cleanup_failed",
        "retention_denied",
        "adapter_conflict"
      ]
    },
    "channelSurfaceSubjectType": {
      "type": "string",
      "enum": [
        "media_asset",
        "collection",
        "selection_snapshot",
        "analysis_run",
        "artifact",
        "diagnostic"
      ]
    },
    "retentionState": {
      "type": "string",
      "enum": [
        "active",
        "soft_deleted",
        "expires_scheduled",
        "expired",
        "hard_delete_eligible",
        "held"
      ]
    },
    "workerKind": {
      "type": "string",
      "enum": [
        "transcription",
        "agent_runner"
      ]
    },
    "taskType": {
      "type": "string",
      "enum": [
        "selection.transcription",
        "selection.analysis"
      ]
    },
    "workerOutcome": {
      "type": "string",
      "enum": [
        "succeeded",
        "partially_succeeded",
        "failed",
        "canceled"
      ]
    }
  }
}
