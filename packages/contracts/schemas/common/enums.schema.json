{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://media-analysis.local/contracts/schemas/common/enums.schema.json",
  "title": "Shared inbox-first enum surface",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "mediaKind": {
      "type": "string",
      "enum": [
        "text",
        "url",
        "file",
        "photo",
        "image",
        "audio",
        "voice",
        "video",
        "document"
      ]
    },
    "mediaAssetStatus": {
      "type": "string",
      "enum": [
        "ingesting",
        "available",
        "invalid",
        "quarantined",
        "deleted"
      ]
    },
    "storedObjectStatus": {
      "type": "string",
      "enum": [
        "publishing",
        "available",
        "delete_scheduled",
        "deleted",
        "missing"
      ]
    },
    "exportOperation": {
      "type": "string",
      "enum": [
        "youtube_audio",
        "youtube_video",
        "video_to_audio"
      ]
    },
    "exportJobStatus": {
      "type": "string",
      "enum": [
        "queued",
        "claimed",
        "running",
        "cancel_requested",
        "succeeded",
        "failed",
        "canceled",
        "expired"
      ]
    },
    "exportDeliveryStatus": {
      "type": "string",
      "enum": [
        "pending",
        "claimed",
        "delivered",
        "failed",
        "expired"
      ]
    },
    "exportDeliveryChannel": {
      "type": "string",
      "enum": [
        "telegram",
        "web"
      ]
    },
    "collectionKind": {
      "type": "string",
      "enum": [
        "inbox",
        "user"
      ]
    },
    "collectionStatus": {
      "type": "string",
      "enum": [
        "active",
        "archived",
        "deleted"
      ]
    },
    "selectionSnapshotStatus": {
      "type": "string",
      "enum": [
        "sealed",
        "invalidated"
      ]
    },
    "analysisRunStatus": {
      "type": "string",
      "enum": [
        "queued",
        "claiming",
        "running",
        "cancel_requested",
        "partially_succeeded",
        "succeeded",
        "failed",
        "canceled",
        "expired"
      ]
    },
    "analysisRunStepStatus": {
      "type": "string",
      "enum": [
        "pending",
        "queued",
        "claimed",
        "succeeded",
        "partially_succeeded",
        "failed",
        "canceled"
      ]
    },
    "runType": {
      "type": "string",
      "enum": [
        "transcription",
        "summary",
        "report",
        "deep_research",
        "custom"
      ]
    },
    "deliveryStrategy": {
      "type": "string",
      "enum": [
        "polling",
        "webhook"
      ]
    },
    "runEventType": {
      "type": "string",
      "enum": [
        "analysis_run.created",
        "analysis_run.started",
        "analysis_run.progress",
        "analysis_run.cancel_requested",
        "analysis_run.completed",
        "analysis_run.failed",
        "analysis_run.canceled",
        "artifact.created",
        "diagnostic.recorded"
      ]
    },
    "artifactKind": {
      "type": "string",
      "enum": [
        "transcript",
        "summary",
        "report",
        "deep_research",
        "structured_data",
        "source_manifest",
        "run_manifest",
        "execution_log",
        "diagnostic_bundle",
        "run_diagnostics",
        "preview"
      ]
    },
    "artifactStatus": {
      "type": "string",
      "enum": [
        "pending",
        "available",
        "failed",
        "expired",
        "deleted"
      ]
    },
    "artifactVisibility": {
      "type": "string",
      "enum": [
        "private",
        "channel_deliverable"
      ]
    },
    "diagnosticSeverity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error"
      ]
    },
    "diagnosticSubjectType": {
      "type": "string",
      "enum": [
        "media_asset",
        "stored_object",
        "collection",
        "selection_snapshot",
        "selection_snapshot_item",
        "analysis_run",
        "analysis_run_step",
        "artifact",
        "artifact_subject",
        "diagnostic",
        "channel_account",
        "channel_surface",
        "operation_request",
        "export_job",
        "export_delivery",
        "stored_object_pin"
      ]
    },
    "diagnosticCode": {
      "type": "string",
      "enum": [
        "media_asset_invalid",
        "channel_account_mismatch",
        "selection_snapshot_invalid",
        "selection_snapshot_not_sealed",
        "stored_object_unavailable",
        "analysis_prerequisite_missing",
        "analysis_prerequisite_failed",
        "analysis_prerequisite_unavailable",
        "collection_version_conflict",
        "worker_failed",
        "artifact_unavailable",
        "artifact_resolution_failed",
        "orphan_object_cleanup",
        "orphan_object_cleanup_failed",
        "retention_denied",
        "adapter_conflict",
        "export_provider_resolution_failed",
        "export_retry_exhausted",
        "export_delivery_failed",
        "retention_delete_failed",
        "retention_reconciled_orphan",
        "stored_object_missing",
        "output_missing"
      ]
    },
    "channelSurfaceSubjectType": {
      "type": "string",
      "enum": [
        "media_asset",
        "collection",
        "selection_snapshot",
        "analysis_run",
        "export_job",
        "export_delivery",
        "artifact",
        "diagnostic"
      ]
    },
    "retentionState": {
      "type": "string",
      "enum": [
        "active",
        "soft_deleted",
        "expires_scheduled",
        "expired",
        "hard_delete_eligible",
        "held"
      ]
    },
    "workerKind": {
      "type": "string",
      "enum": [
        "transcription",
        "agent_runner"
      ]
    },
    "workerOutcome": {
      "type": "string",
      "enum": [
        "succeeded",
        "partially_succeeded",
        "failed",
        "canceled"
      ]
    }
  }
}
